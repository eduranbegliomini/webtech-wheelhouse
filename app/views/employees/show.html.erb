<% content_for :title, @employee.name %>

<h1><%= @employee.name %></h1>
<p class="lead"><strong>Role:</strong> <%= @employee.role %></p>

<h3 class="mt-4">Assigned Repairs</h3>
<% if @employee.repairs.any? %>
  <table class="table table-striped">
    <thead class="table-dark">
      <tr>
        <th>Repair ID</th>
        <th>Bike & Owner</th>
        <th>Status</th>
        <th>Promised On</th>
      </tr>
    </thead>
    <tbody>
      <%= render @employee.repairs %>
    </tbody>
  </table>
<% else %>
  <p>This employee has no assigned repairs.</p>
<% end %>

<div class="mt-4 d-flex gap-2">
  <%= link_to "Edit", edit_employee_path(@employee), class: "btn btn-primary" %>
  <%= button_to "Delete", @employee, method: :delete, data: { turbo_confirm: "Are you sure you want to delete #{@employee.name}?" }, class: "btn btn-danger" %>
  <%= link_to "Back", employees_path, class: "btn btn-outline-secondary" %>
</div>