<%= form_with model: @employee do |f| %>
  <% if @employee.errors.any? %>
    <div class="alert alert-danger">
      <h5>Please fix the following <%= pluralize(@employee.errors.count, "error") %>:</h5>
      <ul>
        <% @employee.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control #{'is-invalid' if @employee.errors[:name].any?}" %>
    <div class="invalid-feedback"><%= @employee.errors[:name].join(", ") %></div>
  </div>

  <div class="mb-3">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: "form-control #{'is-invalid' if @employee.errors[:role].any?}" %>
    <div class="invalid-feedback"><%= @employee.errors[:role].join(", ") %></div>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", employees_path, class: "btn btn-outline-secondary" %>
<% end %>