<% content_for :title, @customer.name %>

<h1><%= @customer.name %></h1>
<p class="lead"><strong>Phone:</strong> <%= @customer.phone %></p>

<h3 class="mt-4">Bikes Owned</h3>
<% if @customer.bikes.any? %>
  <table class="table table-striped">
    <thead class="table-dark">
      <tr>
        <th>Make & Model</th>
        <th>Color</th>
        <th>Owner</th>
        <th>Serial Number</th>
      </tr>
    </thead>
    <tbody>
      <%= render @customer.bikes %>
    </tbody>
  </table>
<% else %>
  <p>This customer does not have any bikes registered yet.</p>
<% end %>

<div class="mt-4 d-flex gap-2">
  <%= link_to "Edit", edit_customer_path(@customer), class: "btn btn-primary" %>
  <%= button_to "Delete", @customer, method: :delete, data: { turbo_confirm: "Are you sure you want to delete #{@customer.name}?" }, class: "btn btn-danger" %>
  <%= link_to "Register New Bike", new_bike_path(customer_id: @customer.id), class: "btn btn-success" %>
  <%= link_to "Back", customers_path, class: "btn btn-outline-secondary" %>
</div>