<h1>Repairs</h1>

<% if @repairs.any? %>
  <table class="table table-hover mt-4">
    <thead class="table-dark">
      <tr>
        <th>Repair ID</th>
        <th>Bike & Owner</th>
        <th>Status</th>
        <th>Promised On</th>
      </tr>
    </thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% else %>
  <p>No active repairs at the moment.</p>
<% end %>