<tr class="<%= 'table-danger' if repair.overdue? %>">
  <td><%= link_to "Repair ID: #{repair.id}", repair_path(repair) %></td>
  <td>
    <%= link_to "#{repair.bike.make} #{repair.bike.model}", bike_path(repair.bike) %> 
    (Owner: <%= link_to repair.bike.customer.name, customer_path(repair.bike.customer) %>)
  </td>
  <td>
    <span class="badge bg-secondary"><%= repair.state %></span>
  </td>
  <td><%= repair.promised_on ? repair.promised_on.to_fs(:long) : "Not set" %></td>
</tr>