<% permitted = policy(@repair).permitted_attributes %>

<%= form_with model: @repair do |f| %>
  <% if @repair.errors.any? %>
    <div class="alert alert-danger">
      <h5>Please fix the following <%= pluralize(@repair.errors.count, "error") %>:</h5>
      <ul>
        <% @repair.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :bike_id, "Bike", class: "form-label" %>
      <% if permitted.include?(:bike_id) %>
        <%= f.collection_select :bike_id, Bike.includes(:customer).all, :id, ->(b) { "#{b.make} #{b.model} (#{b.customer.name})" }, { include_blank: "Select a bike" }, class: "form-select #{'is-invalid' if @repair.errors[:bike_id].any?}" %>
        <div class="invalid-feedback"><%= @repair.errors[:bike_id].join(", ") %></div>
      <% else %>
        <input type="text" class="form-control" value="<%= @repair.bike ? "#{@repair.bike.make} #{@repair.bike.model} (#{@repair.bike.customer.name})" : "None" %>" disabled readonly>
      <% end %>
    </div>
    
    <div class="col-md-6 mb-3">
      <%= f.label :employee_id, "Mechanic", class: "form-label" %>
      <% if permitted.include?(:employee_id) %>
        <%= f.collection_select :employee_id, Employee.all, :id, :name, { include_blank: "Unassigned" }, class: "form-select" %>
      <% else %>
        <input type="text" class="form-control" value="<%= @repair.employee ? @repair.employee.name : "Unassigned" %>" disabled readonly>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-4 mb-3">
      <%= f.label :state, class: "form-label" %>
      <% if permitted.include?(:state) %>
        <%= f.select :state, Repair.states.keys.map { |s| [s.titleize, s] }, {}, class: "form-select" %>
      <% else %>
        <input type="text" class="form-control" value="<%= @repair.state %>" disabled readonly>
      <% end %>
    </div>
    <div class="col-md-4 mb-3">
      <%= f.label :promised_on, class: "form-label" %>
      <% if permitted.include?(:promised_on) %>
        <%= f.date_field :promised_on, class: "form-control #{'is-invalid' if @repair.errors[:promised_on].any?}" %>
        <div class="invalid-feedback"><%= @repair.errors[:promised_on].join(", ") %></div>
      <% else %>
        <input type="text" class="form-control" value="<%= @repair.promised_on %>" disabled readonly>
      <% end %>
    </div>
    <div class="col-md-4 mb-3">
      <%= f.label :handed_back_at, class: "form-label" %>
      <%# En nuestra política, esto lo edita solo el owner/counter, y se actualiza al cambiar estado %>
      <input type="text" class="form-control" value="<%= @repair.handed_back_at %>" disabled readonly>
    </div>
  </div>

  <div class="mb-4">
    <%= f.label :customer_answer, class: "form-label" %>
    <% if permitted.include?(:customer_answer) %>
      <%= f.text_field :customer_answer, class: "form-control #{'is-invalid' if @repair.errors[:customer_answer].any?}" %>
      <div class="invalid-feedback"><%= @repair.errors[:customer_answer].join(", ") %></div>
    <% else %>
      <input type="text" class="form-control" value="<%= @repair.customer_answer %>" disabled readonly>
    <% end %>
  </div>

  <div class="mb-4">
    <%= f.label :diagnosis, "Diagnosis (Rich Text)", class: "form-label fw-bold" %>
    <% if permitted.include?(:diagnosis) %>
      <%= f.rich_text_area :diagnosis, class: "bg-white form-control" %>
    <% else %>
      <div class="bg-light p-3 border rounded">
        <%= @repair.diagnosis.present? ? @repair.diagnosis : "No diagnosis recorded." %>
      </div>
    <% end %>
  </div>

  <div class="mb-4 bg-light p-3 border rounded">
    <%= f.label :intake_photos, "Upload Intake Photos (JPEG or PNG, Max 5MB)", class: "form-label fw-bold" %>
    
    <% if @repair.intake_photos.attached? %>
      <% @repair.intake_photos.each do |photo| %>
        <%= f.hidden_field :intake_photos, multiple: true, value: photo.signed_id %>
      <% end %>
      <p class="text-success small mb-2"><%= pluralize(@repair.intake_photos.count, 'photo') %> already attached.</p>
    <% end %>

    <%= f.file_field :intake_photos, multiple: true, accept: "image/png, image/jpeg", class: "form-control #{'is-invalid' if @repair.errors[:intake_photos].any?}" %>
    <% if @repair.errors[:intake_photos].any? %>
      <div class="invalid-feedback d-block"><%= @repair.errors[:intake_photos].join(", ") %></div>
    <% end %>
  </div>

  <% if permitted.include?(repair_services_attributes: [:id, :service_id, :charged_price, :_destroy]) %>
    <h4 class="mt-4">Services Charged</h4>
    <div class="card p-3 mb-4 bg-light">
      <%= f.fields_for :repair_services do |line_f| %>
        <div class="row mb-2">
          <div class="col-md-6">
            <%= line_f.label :service_id, "Service", class: "form-label visually-hidden" %>
            <%= line_f.collection_select :service_id, Service.all, :id, :name, { include_blank: "No service" }, class: "form-select" %>
          </div>
          <div class="col-md-4">
            <%= line_f.label :charged_price, "Price", class: "form-label visually-hidden" %>
            <%= line_f.number_field :charged_price, step: 0.01, placeholder: "Price ($)", class: "form-control #{'is-invalid' if line_f.object.errors[:charged_price].any?}" %>
          </div>
          <div class="col-md-2 d-flex align-items-center">
            <% if line_f.object.persisted? %>
              <div class="form-check">
                <%= line_f.check_box :_destroy, class: "form-check-input" %>
                <%= line_f.label :_destroy, "Remove", class: "form-check-label text-danger" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", repairs_path, class: "btn btn-outline-secondary" %>
<% end %>