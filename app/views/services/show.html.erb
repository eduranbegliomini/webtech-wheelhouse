<% content_for :title, @service.name %>

<h1><%= @service.name %></h1>
<p class="lead"><strong>Base Price:</strong> <%= number_to_currency(@service.price) %></p>

<div class="mt-4 d-flex gap-2">
  <% if policy(@service).edit? %>
    <%= link_to "Edit", edit_service_path(@service) %>
  <% end %>

  <% if policy(@service).destroy? %>
    <%= button_to "Delete", @service, method: :delete %>
  <% end %>
  
  <%= link_to "Back", services_path, class: "btn btn-outline-secondary" %>
</div>