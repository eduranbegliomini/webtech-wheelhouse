<% content_for :title, @service.name %>

<h1><%= @service.name %></h1>
<p class="lead"><strong>Base Price:</strong> <%= number_to_currency(@service.price) %></p>

<div class="mt-4 d-flex gap-2">
  <%= link_to "Edit", edit_service_path(@service), class: "btn btn-primary" %>
  <%= button_to "Delete", @service, method: :delete, data: { turbo_confirm: "Are you sure you want to delete the service '#{@service.name}'?" }, class: "btn btn-danger" %>
  <%= link_to "Back", services_path, class: "btn btn-outline-secondary" %>
</div>