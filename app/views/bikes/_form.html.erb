<%= form_with model: @bike do |f| %>
  <% if @bike.errors.any? %>
    <div class="alert alert-danger">
      <h5>Please fix the following <%= pluralize(@bike.errors.count, "error") %>:</h5>
      <ul>
        <% @bike.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :customer_id, "Owner", class: "form-label" %>
    <%= f.collection_select :customer_id, Customer.order(:name), :id, :name, { prompt: "Select an owner" }, class: "form-select #{'is-invalid' if @bike.errors[:customer_id].any?}" %>
    <div class="invalid-feedback"><%= @bike.errors[:customer_id].join(", ") %></div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :make, class: "form-label" %>
      <%= f.text_field :make, class: "form-control #{'is-invalid' if @bike.errors[:make].any?}" %>
      <div class="invalid-feedback"><%= @bike.errors[:make].join(", ") %></div>
    </div>

    <div class="col-md-6 mb-3">
      <%= f.label :model, class: "form-label" %>
      <%= f.text_field :model, class: "form-control #{'is-invalid' if @bike.errors[:model].any?}" %>
      <div class="invalid-feedback"><%= @bike.errors[:model].join(", ") %></div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :color, class: "form-label" %>
      <%= f.text_field :color, class: "form-control #{'is-invalid' if @bike.errors[:color].any?}" %>
      <div class="invalid-feedback"><%= @bike.errors[:color].join(", ") %></div>
    </div>

    <div class="col-md-6 mb-3">
      <%= f.label :serial_number, class: "form-label" %>
      <%= f.text_field :serial_number, class: "form-control #{'is-invalid' if @bike.errors[:serial_number].any?}" %>
      <div class="invalid-feedback"><%= @bike.errors[:serial_number].join(", ") %></div>
    </div>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", bikes_path, class: "btn btn-outline-secondary" %>
<% end %>