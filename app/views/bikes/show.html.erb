<% content_for :title, "#{@bike.make} #{@bike.model}" %>

<h1><%= @bike.make %> <%= @bike.model %></h1>
<ul>
  <li><strong>Color:</strong> <%= @bike.color %></li>
  <li><strong>Serial Number:</strong> <%= @bike.serial_number %></li>
  <li><strong>Owner:</strong> <%= link_to @bike.customer.name, customer_path(@bike.customer) %></li>
</ul>

<h3 class="mt-4">Repair History</h3>
<% if @bike.repairs.any? %>
  <table class="table table-striped">
    <thead class="table-dark">
      <tr>
        <th>Repair ID</th>
        <th>Bike & Owner</th>
        <th>Status</th>
        <th>Promised On</th>
      </tr>
    </thead>
    <tbody>
      <%= render @bike.repairs %>
    </tbody>
  </table>
<% else %>
  <p>This bike has no repair history.</p>
<% end %>

<div class="mt-4">
  <%= link_to "Back to Bikes", bikes_path, class: "btn btn-outline-secondary" %>
</div>