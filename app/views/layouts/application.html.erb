<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wheelhouse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Wheelhouse", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><%= link_to "Price List", services_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "About", about_path, class: "nav-link" if respond_to?(:about_path) %></li>
          </ul>
          
          <ul class="navbar-nav">
            <% if authenticated? %>
              <li class="nav-item d-flex align-items-center me-3 text-secondary">
                <%= Current.user.employee&.name || Current.user.email_address %> (<%= Current.user.role %>)
              </li>
              <li class="nav-item">
                <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-outline-danger btn-sm mt-1" %>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Sign in", new_session_path, class: "btn btn-outline-primary btn-sm mt-1" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == 'alert' ? 'danger' : 'success' %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
